<?xml version="1.0" encoding="UTF-8" ?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="objectworksPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entidades mapeadas (cada parte anade aqui las suyas) -->
        <!-- CLIENTES -->
        <class>objectworks.modelo.Cliente</class>
        <!-- HOTELES -->
        <class>objectworks.modelo.Hotel</class>
        <!-- HABITACIONES -->
        <class>objectworks.modelo.Habitacion</class>
        <class>objectworks.modelo.HabitacionEstandar</class>
        <class>objectworks.modelo.HabitacionSuperior</class>
        <class>objectworks.modelo.Suite</class>
        <!-- RESERVAS -->
        <class>objectworks.modelo.Reserva</class>

        <properties>
            <!-- La URL, el usuario y la contrasena los pone JPAUtil leyendo db.properties -->

            <!--Mostrar el SQL que genera Hibernate en la consola y que resulta útil para realizar depuraciones-->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!--Las tablas las crea sql/objectworks_bd.sql: Hibernate no debe crear ni modificar
                la estructura ("update" si la modificaria, por eso usamos "none")-->
            <property name="hibernate.hbm2ddl.auto" value="none"/>
        </properties>
    </persistence-unit>
</persistence>